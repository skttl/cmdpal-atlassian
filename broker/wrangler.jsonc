{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "links-for-atlassian-login",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "CONNECTIONS", "class_name": "Connections" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Connections"] }],
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "START_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
}
